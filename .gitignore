# Secrets / local config — never commit. Use .env.example as the template.
.env
.env.*
!.env.example

# Local DBs (Alembic autogenerate/dev)
*.db

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/

# Eval runner output (build artifact — uploaded by CI, never committed)
eval-out/

# Compiled intent vocabulary (build artifact — regenerate with packages.intents.compile)
packages/intents/build/

# setuptools' scratch directory, left behind by `pip install .` (the Dockerfile's build step).
/build/

# Node (control page)
node_modules/
.next/
.coverage

# uv lockfile — not committed for this project
uv.lock
